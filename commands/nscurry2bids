#!/usr/bin/env python
import tempfile

import click
import os
import numpy as np
from mne.io import read_raw_fif
from mne_bids import BIDSPath, write_raw_bids

from convert2bids.neuroscan import NeuroScanCurry7Processor
from convert2bids.utils import _copy_sourcedata


@click.command()
@click.argument('raw_files', type=click.Path(exists=True), nargs=-1)
@click.argument('task', type=click.Path())
@click.argument('output_path', type=click.Path())
@click.option('-f', '--format', type=str, default='BrainVision',
              help="""'auto', 'Brainvision' or 'FIF'

                        Controls the file format
                        of the data after BIDS conversion. If 'auto', MNE-BIDS
                        will attempt to convert the input data to BIDS without
                        a change of the original file format. A conversion to a
                        different file format (BrainVision, or FIF) will only
                        take place when the original file format lacks some
                        necessary features. When a str is passed, a conversion
                        can be forced to the BrainVision format for EEG, or the
                        FIF format for MEG data.

                        """)
def nscurry2bids(raw_files, task, output_path, format):
    """Convert .dat files to BIDS dataset.

    Clean the NeuroScann Curry 7 format .dat files specified in RAW_FILES and
    add them to a BIDS format dataset stored in OUTPUT_PATH.
    The .dat files should be recorded by the lab equipment while performing
    experimental task TASK.
    These files need to be accompanied in the same directory by their .dat,
    .dap and .rs3 files with metadata.
    These files is optionally accompanied in the same directory by a .txt
    experiment log file with the same filename.

    For example,

        nscurry2bids data/subject_01.bdf data/subject_02.bdf oddball oddball_32

    converts the .bdf files in

    \b
        data
        ├── subject_01.ceo
        ├── subject_01.dap
        ├── subject_01.dat
        ├── subject_01.rs3
        ├── subject_01.txt
        ├── subject_02.ceo
        ├── subject_02.dap
        ├── subject_02.dat
        ├── subject_02.rs3
        └── subject_02.txt


    cleans up the data's channel names and metadata, verifies the registration
    of all stimuli logged in respectively subject_01.txt and subject_02.txt
    and writes the data to sub-subject01 and sub-subject02 with tasks oddball
    to the BIDS dataset stored in oddball_32.
    """
    rawdata_path = os.path.join(output_path, 'rawdata')
    sourcedata_path = os.path.join(output_path, 'sourcedata')
    for i, raw_path in enumerate(raw_files):
        logfile_path = os.path.splitext(raw_path)[0] + '.txt'
        _copy_sourcedata(raw_path, logfile_path, sourcedata_path)
        processor = NeuroScanCurry7Processor(raw_path, logfile_path)
        raw, events = processor.clean()
        # Temporarily save the modified data to disk, because `write_raw_bids`
        # can only copy data, not save preloaded data.
        _, temp_raw_path = tempfile.mkstemp()
        temp_raw_path += '-raw.fif'
        raw.save(temp_raw_path)
        raw = read_raw_fif(temp_raw_path)
        subject_id = os.path.splitext(raw_path)[0]
        subject_id = subject_id.split('/')[-1]
        subject_id = ''.join(ch for ch in subject_id if ch.isalnum())
        bids_path = BIDSPath(subject=subject_id, task=task, root=rawdata_path,
                             run=None, session=None)
        write_raw_bids(raw, bids_path, events_data=events,
                       event_id={str(e): e for e in np.unique(events[:, -1])},
                       overwrite=True, format=format)


if __name__ == '__main__':
    nscurry2bids()
